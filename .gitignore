# Build artifacts
build/
bin/
lib/
*.exe
*.dll
*.so
*.dylib
*.a

# Third-party dependencies (managed as git submodules)
# GLAD is committed directly since it's generated, not a git repo.
# STB header files are committed directly.

# Keep only the CMakeLists.txt for third-party setup
!ThirdParty/CMakeLists.txt
!ThirdParty/*/CMakeLists.txt

# IDE files
.vscode/
.vs/
*.user
*.suo
*.sln
*.vcxproj
*.vcxproj.filters

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Compiled Object files
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib

# Logs
*.log

# Packaged releases
*.zip

# OS files
.DS_Store
Thumbs.db
